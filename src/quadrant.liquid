<div class="layout rounded{% unless trmnl.plugin_settings.custom_fields_values.hide_title_bar ==" true" %} mb--2.5{% endunless %}" style="position: relative; padding: 0;">
  {% if image_url %}
    <img class="image image-dither image--cover w--full h--full" src="{{ image_url }}" alt="{{ image_alt | default: title }}">
  {% endif %}
  <div class="flex flex--col flex--left gap--xsmall" style="position: absolute; left: 8px; right: 80px; bottom: 8px;">
    <span class="title title--small text--white text-stroke text-stroke--base text-stroke--black" data-clamp="2">
      {{ title }}
    </span>
    <span class="description description--small text--white text-stroke text-stroke--base text-stroke--black" data-clamp="3">
      {{ description }}
    </span>
  </div>
  {% unless trmnl.plugin_settings.custom_fields_values.hide_qr_code == "true" %}
    {% if url %}
      <div class="w--16 h--16 bg--white p--1.5 rounded--small" style="position: absolute; right: 8px; bottom: 8px;">
        {{ url | qr_code }}
      </div>
    {% endif %}
  {% endunless %}
</div>
{% unless trmnl.plugin_settings.custom_fields_values.hide_title_bar == "true" %}
  <div class="title_bar">
    <img class="image image-stroke" src="data:image/svg+xml;base64,{{ svg_logo | base64_encode }}" alt>
    <span class="title">Atlas Obscura - Place of the Day</span>
  </div>
{% endunless %}