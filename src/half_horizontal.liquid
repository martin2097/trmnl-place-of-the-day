{%- assign place_ready = false -%}
{%- if image_url != blank and title != blank and description != blank and url != blank -%}
  {%- assign place_ready = true -%}
{% endif %}
<div class="layout rounded p--0 atlas-photo atlas-photo--half-horizontal{{ title_bar_spacing }}">
  {% if place_ready %}
    <img class="image image-dither image--cover w--full h--full" src="{{ image_url }}" alt="{{ image_alt | default: title }}">
    <div class="atlas-photo__copy flex flex--col flex--left gap--xsmall">
      <span class="title title--small md:title--base lg:title--large text--white text-stroke text-stroke--black" data-clamp="2">
        {{ title }}
      </span>
      <span class="description description--base lg:description--large text--white text-stroke text-stroke--black" data-clamp="2" data-clamp-lg="3">
        {{ description }}
      </span>
    </div>
    {% unless hide_qr_code %}
      <div class="atlas-photo__qr w--16 h--16 bg--white p--1.5 rounded--small">
        {{ url | qr_code }}
      </div>
    {% endunless %}
  {% endif %}
  {% unless place_ready %}
    <div class="flex flex--col flex--center text--center gap--small p--4">
      <span class="title">Finding today's wonder...</span>
      <span class="description">Atlas Obscura will appear here shortly.</span>
    </div>
  {% endunless %}
</div>
{% unless hide_title_bar %}
  <div class="title_bar">
    <img class="image image-stroke" src="data:image/svg+xml;base64,{{ svg_logo | base64_encode }}" alt="Atlas Obscura logo">
    <span class="title">Atlas Obscura - Place of the Day</span>
  </div>
{% endunless %}