{%- assign place_ready = false -%}
{%- if image_url != blank and title != blank and description != blank and url != blank -%}
  {%- assign place_ready = true -%}
{% endif %}
<div class="layout mashup mashup--1x1 w--full h--full gap--0 rounded p--0{{ title_bar_spacing }}">
  {% if place_ready %}
    <div class="w--full h--full">
      <img class="image image-dither image--cover w--full h--full" src="{{ image_url }}" alt="{{ image_alt | default: title }}">
    </div>
    <div class="flex flex--row flex--left flex--bottom gap--small p--3 w--full h--full">
      <div class="flex flex--col flex--left flex--bottom gap--xsmall grow">
        <span class="title title--base text--white text-stroke text-stroke--base text-stroke--black" data-clamp="3">
          {{ title }}
        </span>
        <span class="description text--white text-stroke text-stroke--base text-stroke--black" data-clamp="4">
          {{ description }}
        </span>
      </div>
      {% unless hide_qr_code %}
        <div class="w--16 h--16 bg--white p--1.5 rounded--small no-shrink">
          {{ url | qr_code }}
        </div>
      {% endunless %}
    </div>
  {% endif %}
  {% unless place_ready %}
    <div class="flex flex--col flex--center text--center gap--small p--4">
      <span class="title">Finding today's wonder...</span>
      <span class="description">Atlas Obscura will appear here shortly.</span>
    </div>
  {% endunless %}
</div>
{% unless hide_title_bar %}
  <div class="title_bar">
    <img class="image image-stroke" src="data:image/svg+xml;base64,{{ svg_logo | base64_encode }}" alt="Atlas Obscura logo">
    <span class="title">Atlas Obscura - Place of the Day</span>
  </div>
{% endunless %}