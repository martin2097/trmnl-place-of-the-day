{%- assign title_bar_spacing = "" -%}
{%- unless hide_title_bar -%}
  {%- assign title_bar_spacing = " mb--3" -%}
{%- endunless -%}

{% if place_ready %}
  <div class="layout rounded{{ title_bar_spacing }}" style="position: relative; padding: 0;">
    <img class="image image-dither image--cover w--full h--full" src="{{ image_url }}" alt="{{ image_alt | default: title }}">
    <div class="flex flex--col flex--left gap--xsmall" style="position: absolute; left: 12px; right: 100px; bottom: 12px;">
      <span class="title title--base text--white text-stroke text-stroke--black" data-clamp="3">
        {{ title }}
      </span>
      <span class="description text--white text-stroke text-stroke--black" data-clamp="4">
        {{ description }}
      </span>
    </div>
    {% unless hide_qr_code %}
      <div class="w--20 h--20 bg--white p--2 rounded--small" style="position: absolute; right: 12px; bottom: 12px;">
        {{ url | qr_code }}
      </div>
    {% endunless %}
  </div>
{% endif %}

{% unless place_ready %}
  <div class="layout layout--col layout--center rounded">
    <span class="title">Today's place is temporarily unavailable.</span>
    <span class="description">TRMNL will try again automatically.</span>
  </div>
{% endunless %}

{% unless hide_title_bar %}
  <div class="title_bar">
    <img class="image image-stroke" src="data:image/svg+xml;base64,{{ svg_logo | base64_encode }}" alt="Atlas Obscura logo">
    <span class="title">Atlas Obscura - Place of the Day</span>
  </div>
{% endunless %}
